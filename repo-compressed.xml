<file path=".github/workflows/ci.yml">
name: CI
# Docs-only profile (pr-autofix R-04): a check without an application build. The job delegates
# to the pinned devbaseline callable, which derives the `docs` profile from this tree and runs
# `check-docs` — relative links resolve, JSON parses, top-level heading present. There is no
# build step because the profile declares `check.build: null`.
#
# No staging-gate job (R-13): the docs profile declares staging not required, and the coverage
# inventory records `staging_required=false: docs_only` for this repository. R-13 stays binding
# for repositories with a staging target; this one has none to gate on.
#
# Why a workflow named "CI": `workflow_run.workflows` matches the watched workflow by its
# `name:`, and "CI" is the canonical default of the pr-autofix service — so the installed
# `.github/workflows/pr-autofix.yml` watches exactly this gate instead of one of three
# partial-coverage checks. Decision and evidence: trained-assist/trained-agent-architecture#96.
on:
  pull_request:
  push:
    branches: [main]
permissions:
  contents: read
jobs:
  devbaseline:
    uses: trained-assist/pr-autofix/.github/workflows/devbaseline-callable.yml@v1.7.8
    with:
      mode: ci
  # Архитектура — декларативные требования (владелец, 04.10.2026). Чеклисты (`- [ ]` /
  # `- [x]`), TODO/FIXME и файлы чеклистов в репозитории запрещены: они протухают,
  # расходятся с issues и плодят merge-конфликты между параллельными сессиями. Статус
  # требований живёт в GitHub (Project «Trained Assist — Migration», issues).
  no-checklists:
    name: no-checklists
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      - name: Чеклисты и TODO запрещены в репозитории архитектуры
        run: node --test scripts/inventory/no-checklists.test.mjs
</file>

<file path=".github/workflows/coverage-drift.yml">
name: coverage-drift
on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
  # Регенерация таблицы коммитится от GITHUB_TOKEN, а push от GITHUB_TOKEN по правилу GitHub
  # НЕ порождает событие push — гейт после перегенерации сам не перезапускался. Поэтому
  # regenerate в конце сам поднимает repository_dispatch на только что закоммиченный main,
  # и гейт проверяет именно тот коммит, который он же и записал (аудиторская дыра закрыта).
  repository_dispatch:
    types: [coverage-table-regenerated]
  workflow_dispatch:
    inputs:
      regenerate:
        description: 'Перегенерировать и закоммитить таблицу тем же читателем, что и гейт'
        required: false
        type: boolean
        default: false
      tool_ref:
        description: 'Тег pr-autofix, которым генерировать и закрепить в таблице'
        required: false
        type: string
        default: v1.7.6
permissions:
  contents: read
jobs:
  # Таблица — артефакт ТОГО ЖЕ читателя, что и гейт. Пока её коммитили руками с личным токеном
  # владельца, а гейт читал организационным AUTOFIX_PAT, гейт сравнивал две разные таблицы и
  # краснел на карточке, которая сама добавила инвентарь в свой репозиторий (R8).
  # Перегенерация идёт тем же секретом и тем же скриптом, поэтому читатель у них один.
  regenerate:
    if: github.event_name == 'workflow_dispatch' && inputs.regenerate
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      - name: Check out the generator at the requested tag
        uses: actions/checkout@v4
        with:
          repository: trained-assist/pr-autofix
          ref: ${{ inputs.tool_ref }}
          path: .inventory-tool
          persist-credentials: false
      - name: Regenerate with the gate's own reader
        env:
          GH_TOKEN: ${{ secrets.AUTOFIX_PAT }}
          TOOL_REF: ${{ inputs.tool_ref }}
        run: |
          test -n "$GH_TOKEN" || { echo '::error::Organization reader AUTOFIX_PAT is unavailable'; exit 1; }
          node scripts/inventory/regenerate.mjs .inventory-tool docs/inventory "$TOOL_REF"
      - name: Commit when the table actually changed
        id: commit
        run: |
          if git diff --quiet -- docs/inventory; then
            echo "changed=false" >> "$GITHUB_OUTPUT"
            echo "coverage: table already current for pr-autofix $(node -p "require('./docs/inventory/repo-coverage.json').generated_by")"
            exit 0
          fi
          git config user.name "trained-assist-product-owner[bot]"
          git config user.email "agent@trainedassist.store"
          git add docs/inventory
          git commit -m "chore(coverage): перегенерировать таблицу читателем гейта (R8)"
          git push
          echo "changed=true" >> "$GITHUB_OUTPUT"
      - name: Verify the pushed table (repository_dispatch на свежий main)
        if: steps.commit.outputs.changed == 'true'
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          # client_payload обязан быть ОБЪЕКТОМ: -f отправляет значение строкой, и GitHub
          # отвечает 422 "properties/client_payload ... is not an object". Поэтому payload
          # собирается брекет-схемой -F client_payload[sha]=..., а не склейкой JSON в строку.
          gh api -X POST "repos/${GITHUB_REPOSITORY}/dispatches" \
            -f event_type=coverage-table-regenerated \
            -F "client_payload[sha]=$(git rev-parse HEAD)" >/dev/null
          echo "coverage: проверка поднята на $(git rev-parse --short HEAD)"
  coverage-drift:
    if: github.event_name != 'workflow_dispatch'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      # Скоуп сравнения (решение владельца 02.10): PR проверяет ТОЛЬКО те строки инвентаря,
      # которые сам меняет. Таблица — снимок 25 живых репозиториев, поэтому чужая структурная
      # правка в другом репо раньше красила несвязанный PR. Здесь чужая правка этого PR не касается
      # → сравнивать нечего → гейт зелёный. На push в main и на repository_dispatch скоуп
      # всегда полный: там таблица должна быть актуальна целиком.
      - name: Resolve comparison scope
        id: scope
        env:
          GH_TOKEN: ${{ github.token }}
          BASE_SHA: ${{ github.event.pull_request.base.sha }}
        run: |
          set -euo pipefail
          if [ "${{ github.event_name }}" != 'pull_request' ]; then
            echo 'mode=all' >> "$GITHUB_OUTPUT"
            echo 'gate scope: full (push/repository_dispatch) — таблица должна быть актуальна целиком'
            exit 0
          fi
          if ! git diff --name-only "$BASE_SHA" HEAD -- docs/inventory | grep -q .; then
            echo 'mode=none' >> "$GITHUB_OUTPUT"
            echo 'gate scope: empty — этот PR не трогает docs/inventory, сравнивать нечего'
            exit 0
          fi
          gh api "repos/${GITHUB_REPOSITORY}/contents/docs/inventory/repo-coverage.json?ref=${BASE_SHA}" --jq .content \
            | base64 -d > "$RUNNER_TEMP/base-cov.json"
          jq -s -r '
            .[0] as $base | .[1] as $head
            | ($base.repos // []) as $b | ($head.repos // []) as $h
            | ( [ $h[] | . as $r | select( (($b | map(select(.repo == $r.repo)) | first) // null) != $r ) | .repo ]
              + [ $b[] | . as $r | select( ($h | map(select(.repo == $r.repo)) | first) == null) | .repo ]
              ) | unique | .[]
          ' "$RUNNER_TEMP/base-cov.json" docs/inventory/repo-coverage.json > "$RUNNER_TEMP/scope.txt"
          if [ ! -s "$RUNNER_TEMP/scope.txt" ]; then
            echo 'mode=none' >> "$GITHUB_OUTPUT"
            echo 'gate scope: пусто после сравнения строк — дрейфа в затронутых репо нет'
            exit 0
          fi
          {
            echo 'mode=subset'
            echo 'repos<<SCOPE_EOF'
            cat "$RUNNER_TEMP/scope.txt"
            echo 'SCOPE_EOF'
          } >> "$GITHUB_OUTPUT"
          echo "gate scope: только строки, изменённые этим PR:"
          sed 's/^/  - /' "$RUNNER_TEMP/scope.txt"
      - name: Skip comparison when scope is empty
        if: steps.scope.outputs.mode == 'none'
        run: |
          echo "coverage-drift: скоуп пуст, сравнение не выполняется (см. предыдущий шаг)"
      - name: Resolve profile_ref from the committed table
        id: tool
        if: steps.scope.outputs.mode != 'none'
        run: |
          node - <<'NODE'
          const fs = require('fs');
          const rows = require('./docs/inventory/repo-coverage.json').repos;
          const refs = [...new Set(rows.map(r => r.profile_ref))];
          if (refs.length !== 1 || !/^v\d+\.\d+\.\d+$/.test(refs[0])) throw Error('invalid profile_ref');
          fs.appendFileSync(process.env.GITHUB_OUTPUT, `ref=${refs[0]}\n`);
          NODE
      - uses: actions/checkout@v4
        if: steps.scope.outputs.mode != 'none'
        with:
          repository: trained-assist/pr-autofix
          ref: ${{ steps.tool.outputs.ref }}
          path: .inventory-tool
          persist-credentials: false
      - name: Regenerate using the existing organization reader
        if: steps.scope.outputs.mode != 'none'
        env:
          GH_TOKEN: ${{ secrets.AUTOFIX_PAT }}
          TOOL_REF: ${{ steps.tool.outputs.ref }}
          SCOPE_MODE: ${{ steps.scope.outputs.mode }}
          SCOPE_REPOS: ${{ steps.scope.outputs.repos }}
        run: |
          test -n "$GH_TOKEN" || { echo '::error::Organization reader AUTOFIX_PAT is unavailable'; exit 1; }
          node scripts/inventory/regenerate.mjs .inventory-tool "$RUNNER_TEMP/coverage" "$TOOL_REF"
          # Сравнивается СТАБИЛЬНАЯ проекция, а не вся таблица: строка, которую этот читатель не
          # видит, сравнивается только по (repo, read_state). Иначе ответ гейта зависит от того,
          # каким читателем его запустили, и любой перезапуск с другим токеном — ложный дрейф.
          if [ "$SCOPE_MODE" = 'all' ]; then
            diff -u docs/inventory/repo-coverage.stable.json "$RUNNER_TEMP/coverage/repo-coverage.stable.json"
            diff -u docs/inventory/repo-coverage.md "$RUNNER_TEMP/coverage/repo-coverage.md"
            exit 0
          fi
          # subset: посторонние строки вырезаются с обеих сторон, иначе гейт краснел бы из-за
          # чужого репозитория, который этот PR не трогает.
          printf '%s\n' "$SCOPE_REPOS" | jq -R . | jq -s -c . > "$RUNNER_TEMP/scope.json"
          for side in committed fresh; do
            if [ "$side" = committed ]; then SRC=docs/inventory/repo-coverage.stable.json; else SRC="$RUNNER_TEMP/coverage/repo-coverage.stable.json"; fi
            jq --slurpfile scope "$RUNNER_TEMP/scope.json" \
               '.repos |= map(select(.repo as $r | $scope[0] | index($r)))' "$SRC" > "$RUNNER_TEMP/$side.json"
          done
          diff -u "$RUNNER_TEMP/committed.json" "$RUNNER_TEMP/fresh.json"
          # md — таблица; оставляем только строки сцепки со скоупом
          if [ -n "$SCOPE_REPOS" ]; then
            pattern=$(printf '%s\n' "$SCOPE_REPOS" | sed 's/[.[\*^$]/\\&/g; s/^/  - /' | paste -sd'|' -)
            grep -E "$pattern" docs/inventory/repo-coverage.md > "$RUNNER_TEMP/committed.md" || true
            grep -E "$pattern" "$RUNNER_TEMP/coverage/repo-coverage.md" > "$RUNNER_TEMP/fresh.md" || true
            diff -u "$RUNNER_TEMP/committed.md" "$RUNNER_TEMP/fresh.md" || true
          fi
  staging-gate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      - uses: actions/checkout@v4
        with:
          repository: trained-assist/pr-autofix
          ref: v1.7.6
          path: .inventory-tool
          persist-credentials: false
      - name: Coverage drift and credential rejection behavior
        run: node --test scripts/inventory/coverage.test.mjs
</file>

<file path=".github/workflows/pr-autofix.yml">
# Managed by the trained-assist-engineering pr-autofix service.
# Installed for trained-assist/trained-agent-architecture — change the service registration, not this file.
#
# Trigger: the repository CI workflow named below completes. The pinned
# callable only acts on a pull-request CI run that failed, and never on an
# already-fix branch (fix/ci-*), so it cannot loop on its own fixes.
name: PR Autofix
on:
  workflow_run:
    workflows: ["CI"]
    types: [completed]
permissions:
  contents: write
  pull-requests: write
jobs:
  autofix:
    if: >-
      github.event.workflow_run.conclusion == 'failure' &&
      github.event.workflow_run.event == 'pull_request' &&
      github.event.workflow_run.pull_requests[0] != null &&
      !startsWith(github.event.workflow_run.head_branch, 'fix/ci-')
    permissions:
      contents: write
      pull-requests: write
    uses: trained-assist/pr-autofix/.github/workflows/autofix-callable.yml@v1.7.8
    with:
      pr_number: ${{ github.event.workflow_run.pull_requests[0].number }}
      original_branch: ${{ github.event.workflow_run.head_branch }}
      run_id: ${{ github.event.workflow_run.id }}
    secrets:
      llm_ladder_token: ${{ secrets.LLM_LADDER_TOKEN }}
      gh_token: ${{ secrets.AUTOFIX_PAT || github.token }}
</file>

<file path=".github/workflows/repo-context.yml">
name: Repository context
on:
  pull_request:
  push:
    branches: [main]
  workflow_dispatch:
permissions:
  contents: read
jobs:
  context:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: actions/setup-node@v4
        with:
          node-version: '24'
          cache: npm
          cache-dependency-path: tools/repo-context/package-lock.json
      - name: Install pinned packer only (no application build)
        run: npm ci --prefix tools/repo-context --ignore-scripts
      - name: Generate structural pack and bounded map
        run: |
          mkdir -p .repo-context/output
          tools/repo-context/node_modules/.bin/repomix --config .repo-context/repomix.config.json
          python3 tools/repo-context/map.py
      - name: Upload source-pinned context
        uses: actions/upload-artifact@v4
        with:
          name: repo-context-${{ github.sha }}
          path: .repo-context/output/
          if-no-files-found: error
          retention-days: 30
      - name: Show entry point
        run: cat .repo-context/output/REPO-MAP.md >> "$GITHUB_STEP_SUMMARY"
  publish-main:
    needs: context
    if: github.event_name != 'pull_request' && github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    timeout-minutes: 5
    concurrency:
      group: repo-context-publish
      cancel-in-progress: false
    permissions:
      contents: write
    steps:
      - uses: actions/download-artifact@v4
        with:
          name: repo-context-${{ github.sha }}
          path: context
      - name: Publish generated files to separate branch
        env:
          GH_TOKEN: ${{ github.token }}
          SOURCE_REPO: ${{ github.repository }}
          SOURCE_SHA: ${{ github.sha }}
        run: |
          set -eu
          export GIT_CONFIG_COUNT=1
          export GIT_CONFIG_KEY_0=http.https://github.com/.extraheader
          export GIT_CONFIG_VALUE_0="AUTHORIZATION: basic $(printf 'x-access-token:%s' "$GH_TOKEN" | base64 -w0)"
          remote="https://github.com/$SOURCE_REPO.git"
          latest=$(git ls-remote "$remote" refs/heads/main | cut -f1)
          if [ "$latest" != "$SOURCE_SHA" ]; then
            echo 'Source is no longer main HEAD; skip stale publication.'
            exit 0
          fi
          cd context
          git init -b repo-context
          git config user.name 'github-actions[bot]'
          git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
          git remote add origin "$remote"
          old=$(git ls-remote origin refs/heads/repo-context | cut -f1)
          git add REPO-MAP.md repo-compressed.xml manifest.json
          git commit -m "context for $SOURCE_SHA"
          git push --force-with-lease="refs/heads/repo-context:$old" origin HEAD:refs/heads/repo-context
</file>

